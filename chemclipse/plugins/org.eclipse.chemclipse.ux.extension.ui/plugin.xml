<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension-point id="org.eclipse.chemclipse.ux.extension.ui.welcometile" name="Welcome Tile" schema="schema/org.eclipse.chemclipse.ux.extension.ui.welcometile.exsd"/>
   <extension
         id="org.eclipse.chemclipse.ux.extension.ui.modelContribution"
         point="org.eclipse.e4.workbench.model">
      <fragment
            apply="notexists"
            uri="fragment.e4xmi">
      </fragment>
   </extension>
   <extension
         point="org.eclipse.ui.preferencePages">
      <page
            category="org.eclipse.chemclipse.rcp.app.ui.preferences.settingsPreferencePage"
            class="org.eclipse.chemclipse.ux.extension.ui.preferences.PreferencePage"
            id="org.eclipse.chemclipse.ux.extension.ui.preferencePage"
            name="Drive Settings">
      </page>
      <page
            category="org.eclipse.chemclipse.rcp.app.ui.preferences.settingsPreferencePage"
            class="org.eclipse.chemclipse.ux.extension.ui.preferences.PreferencePageUserLocations"
            id="org.eclipse.chemclipse.ux.extension.ui.preferencePageUserLocations"
            name="User Locations">
      </page>      
   </extension>
   <extension
         point="org.eclipse.ui.cheatsheets.cheatSheetContent">
      <category
            name="Basics"
            id="org.eclipse.chemclipse.ux.extension.ui.cheatsheet.basics">
      </category>
      <cheatsheet
            name="Basic Peak Detection and Integration"
            category="org.eclipse.chemclipse.ux.extension.ui.cheatsheet.basics"
            contentFile="cheatsheets/PeakDetectionIntegration.xml"
            id="org.eclipse.chemclipse.ux.extension.ui.cheatsheet.PeakDetectionIntegration">
         <description>
            This cheat sheet will guide you through basic peak detection and integration.
         </description>
      </cheatsheet>
   </extension>
   <extension
         point="org.eclipse.help.contexts">
      <contexts
            file="contexts.xml"
            plugin="org.eclipse.chemclipse.ux.extension.ui">
      </contexts>
   </extension>
   <extension
         point="org.eclipse.ui.themes">
      <fontDefinition
            categoryId="org.eclipse.chemclipse.ux.extension.xxd.ui.charts"
            id="org.eclipse.chemclipse.ux.extension.ui.charts.LabelBounds.PeakLabelFont"
            label="Chromatogram Chart Peak Label Font"
            value="Verdana-regular-8">
         <description>
            The peak label font.
         </description>
      </fontDefinition>
      <colorDefinition
            categoryId="org.eclipse.chemclipse.ux.extension.xxd.ui.charts"
            id="org.eclipse.chemclipse.ux.extension.ui.charts.TargetReferenceLabelMarker.ActiveColor"
            label="Chromatogram Chart Target Reference Label Marker Active Color"
            value="0,0,0">
         <description>
            The color of the active target reference marker.
         </description>
      </colorDefinition>
      <colorDefinition
            categoryId="org.eclipse.chemclipse.ux.extension.xxd.ui.charts"
            id="org.eclipse.chemclipse.ux.extension.ui.charts.TargetReferenceLabelMarker.InactiveColor"
            label="Chromatogram Chart Target Reference Label Marker Inactive Color"
            value="109,109,109">
         <description>
            The color of the inactive target reference marker.
         </description>
      </colorDefinition>
      <colorDefinition
            categoryId="org.eclipse.chemclipse.ux.extension.xxd.ui.charts"
            id="org.eclipse.chemclipse.ux.extension.ui.charts.TargetReferenceLabelMarker.IdColor"
            label="Chromatogram Chart Target Reference Label Marker ID Color"
            value="0,0,0">
         <description>
            The color of the target reference marker ID.
         </description>
      </colorDefinition>
      <fontDefinition
            categoryId="org.eclipse.chemclipse.ux.extension.xxd.ui.charts"
            id="org.eclipse.chemclipse.ux.extension.ui.charts.TargetReferenceLabelMarker.Peak.Font"
            label="Chromatogram Chart Target Reference Peak Label Font"
            value="Verdana-regular-8">
         <description>
            The target reference peak label font.
         </description>
      </fontDefinition>
      <fontDefinition
            categoryId="org.eclipse.chemclipse.ux.extension.xxd.ui.charts"
            id="org.eclipse.chemclipse.ux.extension.ui.charts.TargetReferenceLabelMarker.Scan.Font"
            label="Chromatogram Chart Target Reference Scan Label Font"
            value="Verdana-regular-8">
         <description>
            The target reference scan label font.
         </description>
      </fontDefinition>
   </extension>
</plugin>
