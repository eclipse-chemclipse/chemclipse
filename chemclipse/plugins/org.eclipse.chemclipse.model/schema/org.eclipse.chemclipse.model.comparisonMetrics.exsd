<?xml version='1.0' encoding='UTF-8'?>
<!-- Schema file written by PDE -->
<schema targetNamespace="org.eclipse.chemclipse.model" xmlns="http://www.w3.org/2001/XMLSchema">
<annotation>
      <appInfo>
         <meta.schema plugin="org.eclipse.chemclipse.model" id="org.eclipse.chemclipse.model.comparisonMetrics" name="Comparison Metrics"/>
      </appInfo>
      <documentation>
         This extension point allows an identification algorithm to contribute the metrics it reports, e.g. match scores. The values are stored in the comparison result and are keyed by the metric id. Optionally, the algorithm contributes the rating supplier that normalizes its metrics to a score between 0 and 100 for comparison and judgement.
      </documentation>
   </annotation>

   <element name="extension">
      <annotation>
         <appInfo>
            <meta.element />
         </appInfo>
      </annotation>
      <complexType>
         <sequence minOccurs="1" maxOccurs="unbounded">
            <element ref="Algorithm"/>
         </sequence>
         <attribute name="point" type="string" use="required">
            <annotation>
               <documentation>

               </documentation>
            </annotation>
         </attribute>
         <attribute name="id" type="string">
            <annotation>
               <documentation>

               </documentation>
            </annotation>
         </attribute>
         <attribute name="name" type="string">
            <annotation>
               <documentation>

               </documentation>
               <appInfo>
                  <meta.attribute translatable="true"/>
               </appInfo>
            </annotation>
         </attribute>
      </complexType>
   </element>

   <element name="Algorithm">
      <complexType>
         <sequence minOccurs="0" maxOccurs="unbounded">
            <element ref="Metric"/>
         </sequence>
         <attribute name="id" type="string" use="required">
            <annotation>
               <documentation>
                  The algorithm id is persisted, hence it must not be changed once it has been released.
               </documentation>
            </annotation>
         </attribute>
         <attribute name="label" type="string">
            <annotation>
               <documentation>
                  Human readable name of the algorithm.
               </documentation>
               <appInfo>
                  <meta.attribute translatable="true"/>
               </appInfo>
            </annotation>
         </attribute>
         <attribute name="ratingSupplier" type="string">
            <annotation>
               <documentation>
                  Creates the rating supplier of the algorithm. The rating supplier normalizes the metrics to a score between 0 and 100, so that the results of different algorithms stay comparable. The rating supplier of the classical spectral match is used if this attribute is omitted.
               </documentation>
               <appInfo>
                  <meta.attribute kind="java" basedOn=":org.eclipse.chemclipse.model.identifier.IRatingSupplierFactory"/>
               </appInfo>
            </annotation>
         </attribute>
      </complexType>
   </element>

   <element name="Metric">
      <complexType>
         <attribute name="id" type="string" use="required">
            <annotation>
               <documentation>
                  Identifier of the metric. It is persisted together with the value, hence it must not be changed once it has been released.
               </documentation>
            </annotation>
         </attribute>
         <attribute name="label" type="string" use="required">
            <annotation>
               <documentation>
                  Short label, used as the column header.
               </documentation>
               <appInfo>
                  <meta.attribute translatable="true"/>
               </appInfo>
            </annotation>
         </attribute>
         <attribute name="description" type="string">
            <annotation>
               <documentation>
                  Describes what the metric means, used as a tooltip.
               </documentation>
               <appInfo>
                  <meta.attribute translatable="true"/>
               </appInfo>
            </annotation>
         </attribute>
         <attribute name="format" type="string">
            <annotation>
               <documentation>
                  Decimal format pattern used to render the value, e.g. &quot;0.0&quot; or &quot;0.###E0&quot;. Defaults to &quot;0.0&quot;.
               </documentation>
            </annotation>
         </attribute>
         <attribute name="order" use="default" value="descending">
            <annotation>
               <documentation>
                  Whether a higher (descending) or a lower (ascending) value is better.
               </documentation>
            </annotation>
            <simpleType>
               <restriction base="string">
                  <enumeration value="descending">
                  </enumeration>
                  <enumeration value="ascending">
                  </enumeration>
               </restriction>
            </simpleType>
         </attribute>
         <attribute name="penaltyApplicable" type="boolean" use="default" value="false">
            <annotation>
               <documentation>
                  Whether the penalty of the comparison result is subtracted from the value. This is meaningful for metrics that are scaled from 0 to 100 like the match factor.
               </documentation>
            </annotation>
         </attribute>
      </complexType>
   </element>

</schema>
